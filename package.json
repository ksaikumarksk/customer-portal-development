{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm run backend:dev\" \"npm run frontend:dev\"",
    "build": "pnpm run frontend:build",
    "start": "pnpm run backend:start",
    "backend:dev": "tsx watch app/backend/src/server.ts",
    "backend:start": "tsx app/backend/src/server.ts",
    "frontend:dev": "vite --config app/frontend/vite.config.ts",
    "frontend:build": "vite build --config app/frontend/vite.config.ts",
    "test": "vitest run app/backend/src/server.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "mongoose": "^9.9.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "swagger-ui-express": "^5.0.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "postcss": "^8.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.7.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25"
    }
  }
}
